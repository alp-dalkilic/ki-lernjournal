   "source": [
    "import numpy as np\n",
    "\n",
    "\n",
    "def erweitere_merkmale(x, grad):\n",
    "    X = np.column_stack([x**i for i in range(1, grad + 1)])\n",
    "    return X\n",
    "\n",
    "X_poly = erweitere_merkmale(np.array([1, 2, 3]), 3)\n",
    "print(X_poly)\n"
   ]
