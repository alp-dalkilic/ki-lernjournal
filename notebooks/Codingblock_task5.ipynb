    "# Task 5: Namens-Normalisierer\n",
    "\n",
    "ergebnis = []\n",
    "namensliste = [\"   mueller, anna \", \"SCHMIDT  , ben\", \"mueller,anna\", \"\"]\n",
    "for wort in namensliste:\n",
    "    wort = wort.strip()\n",
    "    ergebnis.append(wort)\n",
    "print(ergebnis)\n",
    "print(ergebnis[1])\n",
    "\n",
    "\n",
    "\n"
   ]
